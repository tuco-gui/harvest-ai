# Copie para .env.local e preencha. Nada daqui vai para o git.

# Supabase — as duas primeiras vão para o navegador, a terceira nunca.
NEXT_PUBLIC_SUPABASE_URL=https://seu-supabase.exemplo.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Busca: NÃO precisa mais de N8N_WEBHOOK_BUSCA. /api/busca chama a SerpAPI
# direto do servidor (ver lib/serpapi.ts) — decisão de 2026-08-13. A chave da
# SerpAPI é por conta, cadastrada em Configurações (conta_credenciais), não
# entra aqui.

# WAHA (WhatsApp HTTP API) — infra compartilhada do servidor, uma instância
# só para todas as contas. Cada conta ganha uma sessão própria (ver lib/waha.ts).
WAHA_API_URL=https://seu-waha.exemplo.com.br
WAHA_API_KEY=

# URL pública onde o WAHA envia webhooks inbound (mensagens recebidas).
# Em produção: https://harvest.figueiramarketing.com.br/api/webhook/waha
# Só sobrescreva se o domínio for diferente do padrão.
WAHA_WEBHOOK_URL=

# Fase 3B — segurança dos webhooks inbound (ver lib/inboundSeguranca.ts).
# Sem qualquer uma destas duas, a rota correspondente rejeita 100% dos
# webhooks (falha fechada) — não existe modo "sem verificação" em produção.
#
# WAHA: mesma chave usada ao criar a sessão com config.webhooks[].hmac.key —
# o WAHA assina o corpo com HMAC-SHA512 e manda em X-Webhook-Hmac.
# Esta chave TAMBÉM é registrada automaticamente no WAHA quando a sessão é
# criada (lib/waha.ts → registrarWebhookWaha), garantindo que o webhook
# funcione sem configuração manual no painel do WAHA.
WAHA_WEBHOOK_HMAC_KEY=

# Evolution: a Evolution não assina webhooks nativamente, então este token
# vai embutido na própria URL cadastrada no provider
# (.../api/webhook/evolution/<este-token>) — gere algo aleatório e longo.
EVOLUTION_WEBHOOK_TOKEN=

# Entrega 15/16 — staging (Vercel Preview/Staging, ver lib/ambienteEnvio.ts
# e componentes/FaixaAmbiente.tsx). Deixe as duas vazias em produção —
# produção nunca deve ter WHATSAPP_MODE=test.
#
# NEXT_PUBLIC_AMBIENTE=staging  → mostra a faixa "AMBIENTE DE TESTE" e ativa
# robots noindex/nofollow. Só definir nos Environment Variables do
# Preview/Staging na Vercel, nunca em produção.
NEXT_PUBLIC_AMBIENTE=

# WHATSAPP_MODE=test → bloqueia (403, fail-closed) qualquer disparo para
# telefone fora de WHATSAPP_QA_WHITELIST, mesmo que WAHA_API_URL/EVOLUTION_*
# estejam configurados por engano para produção. WHATSAPP_QA_WHITELIST é uma
# lista de telefones (só dígitos, E.164) separada por vírgula.
WHATSAPP_MODE=
WHATSAPP_QA_WHITELIST=
