# Variaveis para ambiente HARVEST STAGING APENAS, nao Deskcomm.
# NAO preencher tokens neste arquivo versionado.
NEXT_PUBLIC_AMBIENTE=staging
HARVEST_DESKCOMM_PILOT_ENABLED=false
HARVEST_DESKCOMM_QA_CONTA_ID=
HARVEST_DESKCOMM_API_URL=
HARVEST_DESKCOMM_API_TOKEN=
# A API precisa ser HTTPS, dedicada ao piloto e com token mcp:read pertencente
# somente a organizacao Figueira QA na instalacao Deskcomm isolada.
# A chave so fica no cofre/ambiente de staging, nunca no Git ou console do browser.
