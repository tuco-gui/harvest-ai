    {"id":"normalizar","name":"Somente confirmação CRM explícita","type":"n8n-nodes-base.code","typeVersion":2,"position":[1260,0],"parameters":{"jsCode":"const d = $json;\n// O child existente deve devolver o contrato após validação DOCUMENTADA da resposta CRM.\n// Um HTTP 200, protocolo de planilha ou execução n8n não são confirmação.\nif (d.confirmado_crm === true && d.status === 'cadastrado' && d.codigo_anuncio === 'CA0653_MMOL') {\n return [{json:{status:'cadastrado',confirmado_crm:true,id_superlogica:typeof d.id_superlogica === 'string' ? d.id_superlogica : null}}];\n}\n// Falha anterior ao POST pode ser repetida; resposta ambígua exige LEADS.\nif (d.status === 'nao_enviado' && d.post_executado === false) return [{json:{status:'nao_enviado',post_executado:false}}];\nreturn [{json:{status:'reconciliar',confirmado_crm:false}}];"}},
