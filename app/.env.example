# Copie para .env.local e preencha. Nada daqui vai para o git.

# Supabase — as duas primeiras vão para o navegador, a terceira nunca.
NEXT_PUBLIC_SUPABASE_URL=https://seu-supabase.exemplo.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Ponte da busca: um webhook no n8n que só repassa a chamada à SerpAPI.
# Existe porque o navegador não pode chamar a SerpAPI direto (CORS).
N8N_WEBHOOK_BUSCA=https://seu-n8n.exemplo.com.br/webhook/prospecta-busca
