    {"id":"validar","name":"Validar tenant e contrato","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,0],"parameters":{"jsCode":"const b = $json.body;\nconst allowed = ($env.REALIZE_SUPERLOGICA_WORKSPACES || '').split(',').map(x => x.trim());\nif (!b || !allowed.includes(b.tenant_id) || b.codigo_anuncio !== 'CA0653_MMOL' || !/^[0-9a-f-]{36}$/i.test(b.idempotency_key || '') || !['cadastrar','consultar'].includes(b.acao)) throw new Error('contrato_recusado');\nreturn [{json:b}];"}},
