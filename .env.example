# Copie para .env e preencha. O .env NUNCA vai para o git.
# Usado por scripts/build-workflow.py --local para gerar o JSON já pronto pra importar.

# Supabase (self-hosted ou cloud) — sem barra no final
SUPABASE_URL=https://seu-supabase.exemplo.com
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Evolution API (WhatsApp)
EVOLUTION_URL=https://sua-evolution.exemplo.com
EVOLUTION_INSTANCE=nome_da_instancia
EVOLUTION_API_KEY=

# SerpAPI — https://serpapi.com/manage-api-key
SERPAPI_KEY=

# OpenAI
OPENAI_API_KEY=

# n8n — URLs públicas dos webhooks (o painel só conhece estas)
N8N_WEBHOOK_PAINEL=https://seu-n8n.exemplo.com/webhook/prospecta
N8N_WEBHOOK_BUSCA=https://seu-n8n.exemplo.com/webhook/prospecta-busca
N8N_WEBHOOK_WHATSAPP=https://seu-n8n.exemplo.com/webhook/prospecta-whatsapp
N8N_WEBHOOK_DISPARO=https://seu-n8n.exemplo.com/webhook/SEU-ID-DE-DISPARO
